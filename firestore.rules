rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net: Deny all reads and writes by default
    match /{document=**} {
      allow read, write: if false;
    }

    // Reusable Hardened Helpers
    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidStringArray(arr, maxLen) {
      return arr is list
        && arr.size() <= maxLen
        && (arr.size() == 0 || (arr[0] is string && arr[0].size() >= 1 && arr[0].size() <= 64));
    }

    function isValidBlockList(blocks) {
      return blocks is list
        && blocks.size() <= 100
        && (
          blocks.size() == 0
          || (
            blocks[0] is map
            && blocks[0].keys().hasAll(['uid', 'type'])
            && blocks[0].keys().hasOnly(['uid', 'type', 'param'])
            && blocks[0].uid is string
            && blocks[0].uid.size() >= 1
            && blocks[0].uid.size() <= 64
            && blocks[0].type is string
            && blocks[0].type.size() >= 1
            && blocks[0].type.size() <= 32
            && (!('param' in blocks[0]) || (blocks[0].param is string && blocks[0].param.size() <= 128) || blocks[0].param is number)
          )
        );
    }

    function isValidUserProgress(data, userId) {
      return data.keys().hasAll([
          'uid',
          'username',
          'avatarIcon',
          'avatarTheme',
          'xp',
          'completedPracticals',
          'completedLessons',
          'blocks',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid',
          'username',
          'avatarIcon',
          'avatarTheme',
          'xp',
          'completedPracticals',
          'completedLessons',
          'blocks',
          'createdAt',
          'updatedAt'
        ])
        && data.uid is string
        && data.uid == request.auth.uid
        && data.uid == userId
        && data.username is string
        && data.username.size() >= 2
        && data.username.size() <= 24
        && data.avatarIcon in ['bot', 'cpu', 'rocket', 'compass', 'code']
        && data.avatarTheme in ['sky', 'emerald', 'amber', 'violet', 'rose']
        && data.xp is int
        && data.xp >= 0
        && data.xp <= 1000000
        && isValidStringArray(data.completedPracticals, 50)
        && isValidStringArray(data.completedLessons, 50)
        && isValidBlockList(data.blocks)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidPrivateAccount(data, userId) {
      return data.keys().hasAll(['uid', 'authProvider', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'authProvider', 'email', 'phoneNumber', 'createdAt', 'updatedAt'])
        && data.uid is string
        && data.uid == request.auth.uid
        && data.uid == userId
        && data.authProvider in ['email', 'phone', 'apple', 'google']
        && (!('email' in data) || (data.email is string && data.email.size() <= 254))
        && (!('phoneNumber' in data) || (data.phoneNumber is string && data.phoneNumber.size() <= 32))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // Student Progress & Profile Preferences (No PII)
    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;
      allow list: if false;

      allow create: if isSignedIn()
        && isValidId(userId)
        && request.auth.uid == userId
        && isValidUserProgress(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isSignedIn()
        && isValidId(userId)
        && request.auth.uid == userId
        && isValidUserProgress(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          // Action: Update display profile (username & avatar)
          incoming().diff(existing()).affectedKeys().hasOnly(['username', 'avatarIcon', 'avatarTheme', 'updatedAt'])
          // Action: Sync XP, practicals, lessons, and coding blocks
          || incoming().diff(existing()).affectedKeys().hasOnly(['xp', 'completedPracticals', 'completedLessons', 'blocks', 'updatedAt'])
          // Action: Combined workspace sync
          || incoming().diff(existing()).affectedKeys().hasOnly(['username', 'avatarIcon', 'avatarTheme', 'xp', 'completedPracticals', 'completedLessons', 'blocks', 'updatedAt'])
        );

      allow delete: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;

      // Isolated Private Account PII Subcollection (email, phone number, auth provider)
      match /private/{docId} {
        allow get: if isSignedIn()
          && isValidId(userId)
          && docId == 'account'
          && request.auth.uid == userId;
        allow list: if false;

        allow create: if isSignedIn()
          && isValidId(userId)
          && docId == 'account'
          && request.auth.uid == userId
          && isValidPrivateAccount(incoming(), userId)
          && (
            exists(/databases/$(database)/documents/users/$(userId))
            || existsAfter(/databases/$(database)/documents/users/$(userId))
          )
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;

        allow update: if isSignedIn()
          && isValidId(userId)
          && docId == 'account'
          && request.auth.uid == userId
          && isValidPrivateAccount(incoming(), userId)
          && exists(/databases/$(database)/documents/users/$(userId))
          && incoming().uid == existing().uid
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['authProvider', 'email', 'phoneNumber', 'updatedAt']);

        allow delete: if isSignedIn()
          && isValidId(userId)
          && docId == 'account'
          && request.auth.uid == userId;
      }
    }
  }
}
